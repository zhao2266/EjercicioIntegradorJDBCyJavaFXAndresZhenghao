<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000.0"
            prefHeight="650.0">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>

                <Label text="Candidaturas"/>

                <HBox spacing="10">
                    <children>
                        <TextField promptText="Título"/>
                        <ChoiceBox/>
                        <ChoiceBox/>
                        <TextField promptText="Salario mínimo"/>
                        <DatePicker/>

                        <Button text="Filtrar"/>
                        <Button text="Limpiar"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </top>

    <center>
        <TableView>
            <columns>
                <TableColumn text="Título"/>
                <TableColumn text="Empresa"/>
                <TableColumn text="Estado"/>
                <TableColumn text="Fecha"/>
                <TableColumn text="Salario"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>
                <Button text="Nueva"/>
                <Button text="Editar"/>
                <Button text="Detalle"/>
                <Button text="Borrar"/>
                <ChoiceBox/>
                <Button text="Cambiar estado"/>
                <Button text="Importar CSV"/>
                <Button text="Empresas"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
