<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tracker.controller.FormularioOfertaController"
      spacing="15"
      prefWidth="600">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <Label fx:id="lblTitulo"
               text="Nueva candidatura"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="10">

            <children>

                <Label text="Título" GridPane.rowIndex="0"/>
                <TextField fx:id="txtTitulo"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Empresa" GridPane.rowIndex="1"/>
                <ChoiceBox fx:id="cmbEmpresa"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Estado" GridPane.rowIndex="2"/>
                <ChoiceBox fx:id="cmbEstado"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label text="Fecha" GridPane.rowIndex="3"/>
                <DatePicker fx:id="dpFecha"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"/>

                <Label text="Salario" GridPane.rowIndex="4"/>
                <TextField fx:id="txtSalario"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="1"/>

                <Label text="Enlace" GridPane.rowIndex="5"/>
                <TextField fx:id="txtEnlace"
                           GridPane.rowIndex="5"
                           GridPane.columnIndex="1"/>

                <Label text="Descripción" GridPane.rowIndex="6"/>
                <TextArea fx:id="txtDescripcion"
                          prefHeight="80"
                          GridPane.rowIndex="6"
                          GridPane.columnIndex="1"/>

                <Label text="Notas" GridPane.rowIndex="7"/>
                <TextArea fx:id="txtNotas"
                          prefHeight="80"
                          GridPane.rowIndex="7"
                          GridPane.columnIndex="1"/>

            </children>

        </GridPane>

        <HBox spacing="10">

            <children>

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#guardar"/>

                <Button text="Cancelar"
                        onAction="#cancelar"/>

            </children>

        </HBox>

    </children>

</VBox>