<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tracker.controller.DetalleController"
            prefWidth="1000.0"
            prefHeight="700.0">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>
                <Button text="← Volver" onAction="#volver"/>
                <Label fx:id="lblTitulo" text="Detalle oferta"/>
                <Button text="Editar" onAction="#editar"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">

            <content>

                <VBox spacing="15">

                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>

                    <children>

                        <GridPane hgap="10" vgap="10">

                            <children>

                                <Label text="Estado" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="lblEstado" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Fecha" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Label fx:id="lblFecha" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Salario" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label fx:id="lblSalario" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Enlace" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <Label fx:id="lblEnlace" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Descripción" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <Label fx:id="lblDescripcion" wrapText="true"
                                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Notas" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <Label fx:id="lblNotas" wrapText="true"
                                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            </children>

                        </GridPane>

                        <TitledPane text="Empresa">

                            <content>

                                <GridPane hgap="10" vgap="10">

                                    <children>

                                        <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                        <Label fx:id="lblEmpresa" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                        <Label text="Sector" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                        <Label fx:id="lblSector" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Web" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                        <Label fx:id="lblWeb" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                    </children>

                                </GridPane>

                            </content>

                        </TitledPane>

                        <TitledPane text="Entrevistas" expanded="true">

                            <content>

                                <VBox spacing="10">

                                    <children>

                                        <TableView fx:id="tablaEntrevistas"
                                                   prefHeight="150">

                                            <columns>

                                                <TableColumn fx:id="colFecha"
                                                             text="Fecha"/>

                                                <TableColumn fx:id="colTipo"
                                                             text="Tipo"/>

                                                <TableColumn fx:id="colResultado"
                                                             text="Resultado"/>

                                            </columns>

                                        </TableView>

                                        <GridPane hgap="10" vgap="10">

                                            <children>

                                                <Label text="Fecha"
                                                       GridPane.rowIndex="0"
                                                       GridPane.columnIndex="0"/>

                                                <DatePicker fx:id="dpFecha"
                                                            GridPane.rowIndex="0"
                                                            GridPane.columnIndex="1"/>

                                                <Label text="Tipo"
                                                       GridPane.rowIndex="1"
                                                       GridPane.columnIndex="0"/>

                                                <ChoiceBox fx:id="cmbTipo"
                                                           GridPane.rowIndex="1"
                                                           GridPane.columnIndex="1"/>

                                                <Label text="Resultado"
                                                       GridPane.rowIndex="2"
                                                       GridPane.columnIndex="0"/>

                                                <ChoiceBox fx:id="cmbResultado"
                                                           GridPane.rowIndex="2"
                                                           GridPane.columnIndex="1"/>

                                                <Label text="Notas"
                                                       GridPane.rowIndex="3"
                                                       GridPane.columnIndex="0"/>

                                                <TextArea fx:id="txtNotas"
                                                          prefHeight="60"
                                                          GridPane.rowIndex="3"
                                                          GridPane.columnIndex="1"/>

                                            </children>

                                        </GridPane>

                                        <HBox spacing="10">

                                            <children>

                                                <Button text="Nueva"
                                                        onAction="#nuevaEntrevista"/>

                                                <Button fx:id="btnGuardarEntrevista"
                                                        text="Guardar"
                                                        onAction="#guardarEntrevista"/>

                                                <Button text="Eliminar"
                                                        onAction="#borrarEntrevista"/>

                                            </children>

                                        </HBox>

                                    </children>

                                </VBox>

                            </content>

                        </TitledPane>

                    </children>

                </VBox>

            </content>

        </ScrollPane>
    </center>

</BorderPane>